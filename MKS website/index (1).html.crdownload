<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>Master's Kindergarten School</title>

<style>

*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f5f5f5;
    color:#222;
}

.school-header{
    background:maroon;
    color:white;
    text-align:center;
    padding:25px;
}

.school-header h1{
    margin:0 0 8px;
}

.tabs{
    display:flex;
    flex-wrap:wrap;
    gap:5px;
    padding:10px;
    background:#eee;
    justify-content:center;
}

.tab{
    border:0;
    padding:12px 18px;
    cursor:pointer;
    background:white;
    border-radius:5px;
    font-weight:bold;
}

.tab:hover,
.tab.active{
    background:maroon;
    color:white;
}

main{
    max-width:1200px;
    margin:auto;
    padding:20px;
}

.page{
    display:none;
}

.page.active{
    display:block;
}

.card{
    background:white;
    padding:25px;
    border-radius:10px;
    box-shadow:0 2px 10px #ccc;
    margin-bottom:20px;
}

.hero{
    text-align:center;
    padding:50px 20px;
    background:white;
    border-radius:10px;
}

input,
select,
textarea{
    width:100%;
    padding:11px;
    margin:6px 0 14px;
    border:1px solid #bbb;
    border-radius:5px;
    font-size:15px;
}

textarea{
    min-height:100px;
    resize:vertical;
}

button{
    cursor:pointer;
}

.main-button{
    background:maroon;
    color:white;
    border:0;
    padding:11px 18px;
    border-radius:5px;
    font-weight:bold;
    margin:4px;
}

.secondary-button{
    background:#555;
    color:white;
    border:0;
    padding:11px 18px;
    border-radius:5px;
    font-weight:bold;
    margin:4px;
}

.danger-button{
    background:#b00020;
    color:white;
    border:0;
    padding:11px 18px;
    border-radius:5px;
    font-weight:bold;
    margin:4px;
}

.success-button{
    background:green;
    color:white;
    border:0;
    padding:11px 18px;
    border-radius:5px;
    font-weight:bold;
    margin:4px;
}

.edit-button{
    background:#1565c0;
    color:white;
    border:0;
    padding:8px 14px;
    border-radius:5px;
    margin:3px;
}

button:disabled{
    opacity:.6;
    cursor:not-allowed;
}

.panel-section{
    background:white;
    padding:20px;
    border-radius:10px;
    margin-bottom:20px;
    box-shadow:0 2px 8px #ddd;
}

.item-card,
.result-item,
.student-item{
    background:#fafafa;
    border:1px solid #ddd;
    border-radius:8px;
    padding:15px;
    margin:12px 0;
}

.success-box{
    background:#e8f5e9;
    border-left:5px solid green;
    padding:15px;
    margin:10px 0;
}

.error-box{
    background:#ffebee;
    border-left:5px solid #b00020;
    padding:15px;
    margin:10px 0;
}

.status-box{
    padding:10px;
    border-radius:5px;
    margin:10px 0;
    font-weight:bold;
}

.status-active{
    background:#e8f5e9;
    color:green;
}

.status-suspended{
    background:#fff3cd;
    color:#856404;
}

.status-banned{
    background:#ffebee;
    color:#b00020;
}

.result-table{
    width:100%;
    border-collapse:collapse;
    margin-top:15px;
}

.result-table th,
.result-table td{
    border:1px solid #ccc;
    padding:10px;
    text-align:left;
}

.result-table th{
    background:#eee;
}

.hidden{
    display:none!important;
}

.panel-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    flex-wrap:wrap;
}

.photo-grid{
    display:grid;
    grid-template-columns:
        repeat(auto-fit,minmax(180px,1fr));
    gap:15px;
}

.photo-card{
    background:white;
    border-radius:8px;
    overflow:hidden;
    box-shadow:0 2px 8px #ccc;
}

.photo-card img{
    width:100%;
    height:180px;
    object-fit:cover;
}

.photo-card-content{
    padding:10px;
}

.photo-preview{
    max-width:250px;
    max-height:250px;
    border-radius:8px;
    border:1px solid #ccc;
    display:block;
    margin:10px 0;
}

.inbox-photo{
    width:220px;
    max-width:100%;
    max-height:250px;
    object-fit:contain;
    border:1px solid #ccc;
    border-radius:8px;
    margin:8px;
}

.test-question{
    background:white;
    border:1px solid #ddd;
    border-radius:8px;
    padding:15px;
    margin:12px 0;
}

.timer-box{
    position:sticky;
    top:5px;
    z-index:10;
    background:#fff3cd;
    border:2px solid #856404;
    color:#856404;
    padding:15px;
    border-radius:8px;
    text-align:center;
    font-size:22px;
    font-weight:bold;
    margin:15px 0;
}

.timer-expired{
    background:#ffebee;
    border-color:#b00020;
    color:#b00020;
}

.student-question{
    background:white;
    border:1px solid #ddd;
    border-radius:8px;
    padding:15px;
    margin:12px 0;
}

.student-question label{
    display:block;
    padding:10px;
    margin:5px 0;
    background:#f5f5f5;
    border-radius:5px;
    cursor:pointer;
}

.student-question label:hover{
    background:#eee;
}

.test-submission{
    border-left:5px solid maroon;
    background:#fafafa;
    padding:15px;
    border-radius:8px;
    margin:12px 0;
}

.small-note{
    color:#666;
    font-size:13px;
}

.empty-message{
    color:#666;
    padding:15px;
    text-align:center;
}

.account-photo{
    width:90px;
    height:90px;
    object-fit:cover;
    border-radius:50%;
    border:2px solid #ccc;
}

.admission-photo-section{
    display:flex;
    flex-wrap:wrap;
    gap:20px;
    margin-top:10px;
}

.admission-photo-box{
    flex:1;
    min-width:250px;
}

footer{
    background:maroon;
    color:white;
    text-align:center;
    padding:20px;
    margin-top:30px;
}

@media(max-width:600px){

    .tab{
        width:100%;
    }

    main{
        padding:10px;
    }

    .card,
    .panel-section{
        padding:15px;
    }

    .result-table{
        font-size:13px;
        display:block;
        overflow-x:auto;
    }

}

</style>

</head>

<body>

<header class="school-header">

    <h1>Master's Kindergarten School</h1>

    <p>
        Excellence in Education • Character • Confidence
    </p>

</header>

<nav class="tabs">

    <button class="tab active" data-page="homePage">Home</button>
    <button class="tab" data-page="aboutPage">About</button>
    <button class="tab" data-page="classesPage">Classes</button>
    <button class="tab" data-page="teachersPage">Teachers</button>
    <button class="tab" data-page="resourcesPage">Resources</button>
    <button class="tab" data-page="admissionPage">Admission</button>
    <button class="tab" data-page="contactPage">Contact</button>
    <button class="tab" data-page="resultPage">Show Result</button>
    <button class="tab" data-page="studentPage">Student</button>
    <button class="tab" data-page="staffPage">Staff</button>
    <button class="tab" data-page="principalPage">Principal</button>

</nav>

<main>

<!-- HOME -->

<section id="homePage" class="page active">

    <div class="hero">

        <h2>Welcome to Master's Kindergarten School</h2>

        <p id="homeAbout"></p>

    </div>

    <div class="card">

        <h2>📢 Announcements</h2>

        <div id="homeAnnouncements"></div>

    </div>

    <div class="card">

        <h2>📷 School Photos</h2>

        <div id="homePhotos" class="photo-grid"></div>

    </div>

</section>

<!-- ABOUT -->

<section id="aboutPage" class="page">

    <div class="card">

        <h2>About Our School</h2>

        <p id="aboutText"></p>

    </div>

</section>

<!-- CLASSES -->

<section id="classesPage" class="page">

    <div class="card">

        <h2>Classes</h2>

        <div id="classesList"></div>

    </div>

</section>

<!-- TEACHERS -->

<section id="teachersPage" class="page">

    <div class="card">

        <h2>Our Teachers</h2>

        <div id="teachersList"></div>

    </div>

</section>

<!-- RESOURCES -->

<section id="resourcesPage" class="page">

    <div class="card">

        <h2>📚 Learning Resources</h2>

        <div id="resourcesList"></div>

    </div>

</section>

<!-- ADMISSION -->

<section id="admissionPage" class="page">

    <div class="card">

        <h2>Admission</h2>

        <div id="admissionStatus"></div>

        <form id="admissionForm">

            <input
                id="admissionName"
                placeholder="Student Name"
                required
            >

            <input
                id="admissionParent"
                placeholder="Parent Name"
                required
            >

            <input
                id="admissionPhone"
                placeholder="Phone Number"
                required
            >

            <input
                id="admissionClass"
                placeholder="Class"
                required
            >

            <div class="admission-photo-section">

                <div class="admission-photo-box">

                    <label>
                        <strong>📷 Student Photo</strong>
                    </label>

                    <input
                        id="admissionStudentPhoto"
                        type="file"
                        accept="image/*"
                        required
                    >

                </div>

                <div class="admission-photo-box">

                    <label>
                        <strong>📄 Form B Photo</strong>
                    </label>

                    <input
                        id="FormBPhoto"
                        type="file"
                        accept="image/*"
                        required
                    >

                </div>

            </div>

            <button
                class="main-button"
                type="submit"
            >
                Send Admission Application
            </button>

        </form>

        <p id="admissionMessageOutput"></p>

        <div id="admissionTestSchedule"></div>

    </div>

</section>

<!-- CONTACT -->

<section id="contactPage" class="page">

    <div class="card">

        <h2>Contact School</h2>

        <p id="contactInformation"></p>

        <form id="contactForm">

            <input
                id="contactName"
                placeholder="Your Name"
                required
            >

            <input
                id="contactEmail"
                type="email"
                placeholder="Email"
                required
            >

            <textarea
                id="contactMessage"
                placeholder="Your Message"
                required
            ></textarea>

            <button class="main-button" type="submit">
                Send Message
            </button>

        </form>

        <p id="contactMessageOutput"></p>

    </div>

</section>

<!-- RESULT -->

<section id="resultPage" class="page">

    <div class="card">

        <h2>📊 Student Result</h2>

        <form id="resultSearchForm">

            <select id="resultGrade" required>

                <option value="">Select Class</option>
                <option>Play Group</option>
                <option>Nursery</option>
                <option>Prep</option>
                <option>1st</option>
                <option>2nd</option>
                <option>3rd</option>
                <option>4th</option>
                <option>5th</option>
                <option>6th</option>
                <option>7th</option>
                <option>8th</option>

            </select>

            <input
                id="resultRoll"
                placeholder="Roll Number"
                required
            >

            <button class="main-button" type="submit">
                Show Result
            </button>

        </form>

        <div id="resultOutput"></div>

    </div>

</section>

<!-- STUDENT -->

<section id="studentPage" class="page">

    <div class="card">

        <h2>👨‍🎓 Student Login</h2>

        <form id="studentLoginForm">

            <input
                id="studentUsername"
                placeholder="Username"
                required
            >

            <input
                id="studentPassword"
                type="password"
                placeholder="Password"
                required
            >

            <button class="main-button" type="submit">
                Student Login
            </button>

        </form>

        <div id="studentLoginMessage"></div>

    </div>

    <div id="studentDashboard" class="hidden">

        <div class="card">

            <h2>
                Welcome,
                <span id="studentWelcome"></span>
            </h2>

            <button
                id="studentLogoutButton"
                class="secondary-button"
                type="button"
            >
                Logout
            </button>

        </div>

        <div class="panel-section">

            <h3>📝 My Class Tests</h3>

            <div id="studentTestsOutput"></div>

        </div>

        <div class="panel-section">

            <h3>📊 My Test Results</h3>

            <div id="studentTestResults"></div>

        </div>

    </div>

</section>

<!-- STAFF -->

<section id="staffPage" class="page">

    <div id="staffLoginPanel" class="card">

        <h2>👨‍🏫 Staff Login</h2>

        <form id="staffLoginForm">

            <input
                id="staffUsername"
                placeholder="Username"
                required
            >

            <input
                id="staffPassword"
                type="password"
                placeholder="Password"
                required
            >

            <button class="main-button" type="submit">
                Staff Login
            </button>

        </form>

        <div id="staffLoginMessage"></div>

    </div>

    <div id="staffDashboard" class="hidden">

        <div class="card">

            <h2>Staff Panel</h2>

            <button
                id="staffLogoutButton"
                class="secondary-button"
                type="button"
            >
                Logout
            </button>

        </div>

        <!-- CREATE / EDIT STUDENT -->

        <div class="panel-section">

            <h3>👨‍🎓 Create / Edit Student Account</h3>

            <input
                id="studentName"
                placeholder="Student Name"
            >

            <input
                id="studentRoll"
                placeholder="Roll Number"
            >

            <select id="studentGrade">

                <option value="">Select Class</option>
                <option>Play Group</option>
                <option>Nursery</option>
                <option>Prep</option>
                <option>1st</option>
                <option>2nd</option>
                <option>3rd</option>
                <option>4th</option>
                <option>5th</option>
                <option>6th</option>
                <option>7th</option>
                <option>8th</option>

            </select>

            <input
                id="studentUsernameCreate"
                placeholder="Student Username"
            >

            <input
                id="studentPasswordCreate"
                type="password"
                placeholder="Student Password"
            >

            <input
                id="editingStudentId"
                type="hidden"
            >

            <button
                id="createStudentButton"
                class="main-button"
                type="button"
            >
                Create Student
            </button>

            <button
                id="cancelStudentEditButton"
                class="secondary-button hidden"
                type="button"
            >
                Cancel Edit
            </button>

        </div>

        <!-- STUDENT ACCOUNT CONTROL -->

        <div class="panel-section">

            <h3>🔐 Student Account Control</h3>

            <div id="staffStudentsList"></div>

        </div>

        <!-- NORMAL RESULT -->

        <div class="panel-section">

            <h3>📊 Create / Edit Result</h3>

            <input
                id="resultStudentName"
                placeholder="Student Name"
            >

            <input
                id="resultStudentRoll"
                placeholder="Roll Number"
            >

            <select id="resultStudentGrade">

                <option value="">Select Class</option>
                <option>Play Group</option>
                <option>Nursery</option>
                <option>Prep</option>
                <option>1st</option>
                <option>2nd</option>
                <option>3rd</option>
                <option>4th</option>
                <option>5th</option>
                <option>6th</option>
                <option>7th</option>
                <option>8th</option>

            </select>

            <div id="subjectInputs"></div>

            <button
                id="addSubjectButton"
                class="secondary-button"
                type="button"
            >
                + Add Subject
            </button>

            <button
                id="saveResultButton"
                class="main-button"
                type="button"
            >
                Save / Update Result
            </button>

            <div id="staffResultsList"></div>

        </div>

        <!-- TEST CREATION -->

        <div class="panel-section">

            <h3>📝 Create Student Test</h3>

            <select id="testClass">

                <option value="">Select Class</option>
                <option>Play Group</option>
                <option>Nursery</option>
                <option>Prep</option>
                <option>1st</option>
                <option>2nd</option>
                <option>3rd</option>
                <option>4th</option>
                <option>5th</option>
                <option>6th</option>
                <option>7th</option>
                <option>8th</option>

            </select>

            <input
                id="testTitle"
                placeholder="Test Title"
            >

            <input
                id="testSubject"
                placeholder="Subject"
            >

            <label>
                <strong>Test Time (minutes)</strong>
            </label>

            <input
                id="testDuration"
                type="number"
                min="1"
                value="30"
            >

            <p class="small-note">
                When the timer reaches zero, the test is
                automatically submitted.
            </p>

            <textarea
                id="testInstructions"
                placeholder="Test Instructions"
            ></textarea>

            <div id="testQuestions"></div>

            <button
                id="addQuestionButton"
                class="secondary-button"
                type="button"
            >
                + Add Question
            </button>

            <button
                id="saveTestButton"
                class="main-button"
                type="button"
            >
                Save Test
            </button>

            <button
                id="clearTestButton"
                class="secondary-button"
                type="button"
            >
                Clear Test Form
            </button>

        </div>

        <!-- TEST LIST -->

        <div class="panel-section">

            <h3>📚 Tests Created by Staff</h3>

            <div id="staffTestsList"></div>

        </div>

        <!-- SUBMISSIONS -->

        <div class="panel-section">

            <h3>📥 Student Test Submissions</h3>

            <p class="small-note">
                Tests submitted by students appear here.
                Staff can edit the marks.
            </p>

            <div id="testMarkSheets"></div>

        </div>

    </div>

</section>

<!-- PRINCIPAL -->

<section id="principalPage" class="page">

    <div id="principalLoginPanel" class="card">

        <h2>👑 Principal Login</h2>

        <form id="principalLoginForm">

            <input
                id="principalUsername"
                placeholder="Username"
                required
            >

            <input
                id="principalPassword"
                type="password"
                placeholder="Password"
                required
            >

            <button class="main-button" type="submit">
                Principal Login
            </button>

        </form>

        <div id="principalLoginMessage"></div>

    </div>

    <div id="principalDashboard" class="hidden">

        <div class="card">

            <h2>👑 Principal Panel</h2>

            <button
                id="principalLogoutButton"
                class="secondary-button"
                type="button"
            >
                Logout
            </button>

        </div>

        <div class="panel-section">

            <h3>School About</h3>

            <textarea id="principalAbout"></textarea>

            <button
                id="saveAboutButton"
                class="main-button"
                type="button"
            >
                Save About
            </button>

        </div>

        <div class="panel-section">

            <h3>📚 Add Resource</h3>

            <input
                id="resourceTitle"
                placeholder="Resource Title"
            >

            <textarea
                id="resourceContent"
                placeholder="Resource Content"
            ></textarea>

            <button
                id="addResourceButton"
                class="main-button"
                type="button"
            >
                Add Resource
            </button>

            <div id="principalResourcesList"></div>

        </div>

        <div class="panel-section">

            <h3>📷 Add Home Photo</h3>

            <input
                id="homePhoto"
                type="file"
                accept="image/*"
            >

            <button
                id="addHomePhotoButton"
                class="main-button"
                type="button"
            >
                Add Photo
            </button>

            <div
                id="principalHomePhotos"
                class="photo-grid"
            ></div>

        </div>

        <div class="panel-section">

            <h3>Class Information</h3>

            <select id="principalGrade">

                <option value="">Select Grade</option>
                <option>Play Group</option>
                <option>Nursery</option>
                <option>Prep</option>
                <option>1st</option>
                <option>2nd</option>
                <option>3rd</option>
                <option>4th</option>
                <option>5th</option>
                <option>6th</option>
                <option>7th</option>
                <option>8th</option>

            </select>

            <input
                id="principalTeacher"
                placeholder="Teacher"
            >

            <input
                id="principalSubjects"
                placeholder="English, Mathematics, Science"
            >

            <button
                id="saveClassButton"
                class="main-button"
                type="button"
            >
                Save Class
            </button>

        </div>

        <div class="panel-section">

            <h3>Add Teacher</h3>

            <input
                id="teacherName"
                placeholder="Teacher Name"
            >

            <input
                id="teacherSubject"
                placeholder="Subject"
            >

            <textarea
                id="teacherDescription"
                placeholder="Description"
            ></textarea>

            <input
                id="teacherPhoto"
                type="file"
                accept="image/*"
            >

            <button
                id="addTeacherButton"
                class="main-button"
                type="button"
            >
                Add Teacher
            </button>

            <div id="principalTeachersList"></div>

        </div>

        <div class="panel-section">

            <h3>Publish Announcement</h3>

            <input
                id="announcementTitle"
                placeholder="Announcement Title"
            >

            <textarea
                id="announcementBody"
                placeholder="Announcement Text"
            ></textarea>

            <button
                id="publishAnnouncementButton"
                class="main-button"
                type="button"
            >
                Publish Announcement
            </button>

        </div>

        <div class="panel-section">

            <h3>🎓 Admission Control</h3>

            <button
                id="openAdmissionButton"
                class="success-button"
                type="button"
            >
                Allow Admission
            </button>

            <button
                id="closeAdmissionButton"
                class="danger-button"
                type="button"
            >
                Don't Allow Admission
            </button>

            <input
                id="admissionTestDate"
                type="date"
            >

            <input
                id="admissionTestTime"
                type="time"
            >

            <button
                id="saveAdmissionScheduleButton"
                class="main-button"
                type="button"
            >
                Save Admission Test Date/Time
            </button>

            <div id="principalAdmissionStatus"></div>

        </div>

        <div class="panel-section">

            <h3>🔐 Change Principal Password</h3>

            <input
                id="principalOldPassword"
                type="password"
                placeholder="Old Principal Password"
            >

            <input
                id="principalNewPassword"
                type="password"
                placeholder="New Principal Password"
            >

            <button
                id="changePrincipalPasswordButton"
                class="main-button"
                type="button"
            >
                Change Principal Password
            </button>

        </div>

        <div class="panel-section">

            <h3>🔐 Change Staff Password</h3>

            <input
                id="principalStaffOldPassword"
                type="password"
                placeholder="Current Staff Password"
            >

            <input
                id="principalStaffNewPassword"
                type="password"
                placeholder="New Staff Password"
            >

            <button
                id="principalChangeStaffPasswordButton"
                class="main-button"
                type="button"
            >
                Change Staff Password
            </button>

        </div>

        <!-- INBOX -->

        <div class="panel-section">

            <div class="panel-header">

                <h3>📥 Principal Inbox</h3>

                <button
                    id="deleteAllInboxButton"
                    class="danger-button"
                    type="button"
                >
                    Delete All Old Mails
                </button>

            </div>

            <div id="principalInbox"></div>

        </div>

    </div>

</section>

</main>

<footer>

    <p>© Master's Kindergarten School</p>

</footer>

<script src="script.js"></script>

</body>
</html>